{
  "name": "payment-api",
  "version": "0.1.0",
  "description": "handles payment api request",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "node dist/server.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^30.0.0",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "babel-jest": "^30.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "pg": "^8.16.3",
    "prettier": "^3.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
